# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Asset meta data should not be ignored
!/[Aa]ssets/**/*.meta
!/[Aa]ssets/**.meta
# Visual Studio / Rider cache
.vs/
.idea/
.vscode/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Art assets (source files, not tracked)
/[Aa]ssets/[Aa]rts/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Wwise generated sound banks (Wwise 源工程在仓库外，bank 产物可重新生成，不进版本库)
/[Aa]ssets/[Ss]treaming[Aa]ssets/[Aa]udio/[Gg]enerated[Ss]ound[Bb]anks/

# Plastic SCM
*.ignore
*.merge

# OS
Thumbs.db
.DS_Store
